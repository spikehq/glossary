---
layout: layouts/base.hbs
permalink: /
---
<section class="hero" aria-labelledby="page-title">
    <div class="page hero__inner">
        <h1 id="page-title">Incident Response Glossary</h1>
        <p class="hero__sub">Master the Language of Modern Incident Response</p>
        <p class="hero__lede">
            Curious about how modern teams keep systems reliable? This glossary is a beginner-friendly guide to
            incident response — with over 500 terms covering on-call, alerting, monitoring, and system reliability.
            Whether you're just getting started or part of an SRE, DevOps, or operations team, this is your go-to
            reference for everything incident-related.
        </p>
    </div>
</section>

<div class="toolbar-wrap">
    <div class="page">
        <div class="toolbar card">
            <div class="toolbar__top">
                <nav class="az" aria-label="Jump to letter">
                    <ul class="az__list">{{#each collections.alphabetNav}}<li>{{#if this.count}}<a href="#letter-{{this.letter}}" data-letter="letter-{{this.letter}}">{{this.letter}}<span class="sr-only"> — {{this.count}} terms</span></a>{{else}}<span>{{this.letter}}<span class="sr-only"> — no terms</span></span>{{/if}}</li>{{/each}}</ul>
                </nav>

                <form class="search" role="search" id="search-form" autocomplete="off">
                    <svg class="search__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                    <label class="sr-only" for="q">Search {{collections.glossaryItems.length}} glossary terms</label>
                    <input type="search" id="q" name="q" placeholder="Search terms…" enterkeyhint="search" autocomplete="off" aria-describedby="search-help">
                    <span class="search__hint" aria-hidden="true"><kbd class="key">/</kbd></span>
                </form>
            </div>

            <p class="sr-only" id="search-help">Results filter as you type. Press the down arrow to step into the list, arrow keys to move between terms, Enter to open a term.</p>

            <p class="toolbar__meta">
                <span class="toolbar__count" id="result-count" role="status">{{collections.glossaryItems.length}} terms</span>
            </p>
        </div>
    </div>
</div>

{{!-- Mobile only: the inline search row above is hidden entirely at this
      width (see the max-width:39.999rem rules in glossary.css) and reached
      instead through this FAB, which opens the mobile-scoped command
      palette below — see glossary.js. --}}
<button type="button" id="mobile-search-toggle" class="mobile-search-fab" aria-label="Search terms" aria-haspopup="dialog" aria-controls="palette">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
</button>
{{> palette mobileOnly=true}}

{{!-- Sits directly under the sticky toolbar, but outside it: unlike the count,
      this legend doesn't need to stay pinned while scrolling, so it lives here
      and scrolls away with the page. Duplicated by #search-help for screen
      readers, so this copy is decorative. --}}
<div class="page">
    <p class="toolbar__keys" aria-hidden="true">
        <kbd class="key">&uarr;</kbd><kbd class="key">&darr;</kbd><kbd class="key">&larr;</kbd><kbd class="key">&rarr;</kbd> move
        <kbd class="key">&crarr;</kbd> open
        <kbd class="key">/</kbd> search
    </p>
</div>

<div class="page">
    <div class="letters" id="term-list" data-count="{{collections.glossaryItems.length}}">
        {{#each collections.glossaryItemsByLetter}}
            <section class="letter" id="letter-{{@key}}" aria-labelledby="heading-{{@key}}" style="--n:{{this.length}}">
                <div class="letter__head">
                    <h2 id="heading-{{@key}}">{{@key}}</h2>
                    <p class="letter__count">{{this.length}} terms</p>
                </div>
                {{!-- Emitted without indentation on purpose: at 549 cards the
                      pretty-printing alone is tens of kilobytes to download
                      and parse. --}}
                <ul class="terms">{{#each this}}<li><a class="term-card" href="{{@root.site.base}}/{{this.slug}}/" data-k="{{lower this.title}}"><h3>{{this.title}}</h3><p>{{truncate this.excerpt 130}}</p></a></li>{{/each}}</ul>
            </section>
        {{/each}}
    </div>

    <div class="card empty-state" id="no-results" hidden>
        <h2>No matching terms</h2>
        <p>Try a shorter search, or clear it to browse all {{collections.glossaryItems.length}} terms A–Z.</p>
    </div>

    <section class="card faq" aria-labelledby="faq-title">
        <h2 id="faq-title">About this glossary</h2>
        <dl class="faq__list">
            <dt>What is the Incident Response Glossary?</dt>
            <dd>It's a curated collection of {{collections.glossaryItems.length}}+ terms to help teams understand key concepts in incident management, monitoring, on-call response, and DevOps.</dd>
            <dt>How can I use this glossary?</dt>
            <dd>You can browse terms alphabetically, use the search, or explore related terms to learn incident response more effectively.</dd>
        </dl>
        <a class="btn" href="{{site.social.github}}">Contribute a term on GitHub</a>
    </section>
</div>
