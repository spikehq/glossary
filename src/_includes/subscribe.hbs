<section class="card side-card subscribe" aria-labelledby="subscribe-title">
    <h2 id="subscribe-title">Incident response, in your inbox</h2>
    <p>Occasional posts on on-call, alerting and reliability. No noise — we know what alert fatigue is.</p>

    <form id="subscribe-form" action="https://app.loops.so/api/newsletter-form/clmbi4htj0022l10nmkpz5yey" method="post">
        <input type="hidden" name="source" value="Glossary">
        <input type="hidden" name="userGroup" value="Glossary">
        <label class="sr-only" for="subscribe-email">Email address</label>
        <input type="email" id="subscribe-email" name="email" placeholder="you@example.com" autocomplete="email" required>
        <button type="submit" class="btn">Subscribe</button>
    </form>

    <p class="subscribe__msg" id="subscribe-msg" role="status" hidden></p>
</section>
