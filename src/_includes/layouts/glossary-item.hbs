---
layout: layouts/base.hbs
---
<div class="page">
    <nav class="crumbs" aria-label="Breadcrumb">
        <ol>
            <li><a href="{{site.homeUrl}}">Spike</a></li>
            <li class="crumbs__sep" aria-hidden="true">/</li>
            <li><a href="{{site.base}}/">Glossary</a></li>
            <li class="crumbs__sep" aria-hidden="true">/</li>
            <li aria-current="page">{{term}}</li>
        </ol>
    </nav>
</div>

<div class="toolbar-wrap toolbar-wrap--slim">
    <div class="page">
        <div class="toolbar toolbar--slim card">
            <a class="btn btn--ghost" href="{{site.base}}/">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
                All terms
            </a>
            <button type="button" class="search-button js-only" id="open-palette">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <span>Search the glossary</span>
                <kbd class="key" aria-hidden="true">/</kbd>
            </button>
        </div>
    </div>
</div>

<div class="page">
    <div class="term-layout">
        <div class="term-main">
            <article class="card term-head">
                <p class="eyebrow">Incident response glossary</p>
                <h1>{{term}}</h1>
                <p class="term-head__lede">{{excerpt}}</p>

                <div class="prose">
                    {{{markSpikeSections content featuredHeading}}}
                </div>
            </article>

            {{#with (termNeighbours page.fileSlug collections.glossaryItems)}}
                <nav class="pager" aria-label="Nearby terms">
                    {{#if prev}}
                        <a class="pager__prev" data-pager="prev" href="{{@root.site.base}}/{{prev.slug}}/" rel="prev">
                            <span class="pager__label"><kbd class="key" aria-hidden="true">&larr;</kbd> Previous term</span>
                            <span class="pager__term">{{prev.title}}</span>
                        </a>
                    {{/if}}
                    {{#if next}}
                        <a class="pager__next" data-pager="next" href="{{@root.site.base}}/{{next.slug}}/" rel="next">
                            <span class="pager__label">Next term <kbd class="key" aria-hidden="true">&rarr;</kbd></span>
                            <span class="pager__term">{{next.title}}</span>
                        </a>
                    {{/if}}
                </nav>
            {{/with}}

            <section class="further" aria-labelledby="further-title">
                <h2 id="further-title">Further reading</h2>
                <ul>
                    {{#each (furtherReading page.fileSlug related collections.glossaryItems 3)}}
                        <li>
                            <a class="term-card" href="{{@root.site.base}}/{{this.slug}}/">
                                <h3>{{this.title}}</h3>
                                <p>{{truncate this.excerpt 150}}</p>
                            </a>
                        </li>
                    {{/each}}
                </ul>
            </section>
        </div>

        <aside class="term-aside" aria-label="More from Spike">
            <section class="card side-card" aria-labelledby="cta-title">
                <h2 id="cta-title">Put this into practice</h2>
                <p>Spike turns alerts into on-call incidents your team can acknowledge, escalate and resolve — in minutes.</p>
                <a class="cta" href="{{site.signupUrl}}?utm_source=glossary&amp;utm_medium=sidebar">
                    Get started
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
                <div class="side-links">
                    <a href="https://spike.sh/quiz?utm_source=glossary">What's the root cause? Take the quiz</a>
                    <a href="https://spike.sh/blog/pagerduty-pricing-breakdown-2025-and-how-to-save-85/?utm_source=glossary">PagerDuty pricing, broken down</a>
                </div>
            </section>

            {{> subscribe}}
        </aside>
    </div>
</div>

{{!-- Command palette: ships empty and hidden, hydrates from terms.json the
      first time someone presses / or ⌘K. --}}
<div class="palette" id="palette" hidden data-src="{{site.base}}/terms.json" data-base="{{site.base}}">
    <div class="palette__scrim"></div>
    <div class="palette__panel" role="dialog" aria-modal="true" aria-labelledby="palette-title">
        <h2 class="sr-only" id="palette-title">Search the glossary</h2>
        <div class="palette__field">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <label class="sr-only" for="palette-input">Search terms</label>
            <input type="text" id="palette-input" role="combobox" aria-expanded="false" aria-controls="palette-results" aria-autocomplete="list" autocomplete="off" placeholder="Search terms…">
        </div>
        <ul class="palette__results" id="palette-results" role="listbox" aria-label="Matching terms"></ul>
        <p class="palette__empty" id="palette-note" hidden></p>
        <p class="palette__foot" aria-hidden="true">
            <span><kbd class="key">&uarr;</kbd><kbd class="key">&darr;</kbd> move</span>
            <span><kbd class="key">&crarr;</kbd> open</span>
            <span><kbd class="key">esc</kbd> close</span>
        </p>
    </div>
</div>
