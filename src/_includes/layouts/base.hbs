<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#fcfbf9" id="theme-color">

    <title>{{pageTitle}}</title>
    <meta name="description" content="{{metaDescription}}">
    <link rel="canonical" href="{{pageUrl}}">
    <meta name="robots" content="index, follow">
    <meta name="author" content="Spike.sh">

    {{!-- Theme: resolve before first paint so there is no flash and no shift.
          Also marks the document as script-enabled, which is how JS-only
          controls (theme toggle, search) unhide themselves. --}}
    <script>
        (function () {
            var e = document.documentElement;
            e.className += " js header-booting";
            try {
                var s = localStorage.getItem("spike-theme");
                // Three states: "light" / "dark" pin the theme; anything else
                // (including no stored value) follows the OS preference.
                var pref = s === "light" || s === "dark" ? s : "system";
                e.setAttribute("data-theme-pref", pref);
                if (pref === "dark" || (pref === "system" && matchMedia("(prefers-color-scheme: dark)").matches)) {
                    e.className += " dark";
                    document.getElementById("theme-color").content = "#161618";
                }
            } catch (x) {
                e.setAttribute("data-theme-pref", "system");
            }
        })();
    </script>

    {{!-- Self-hosted variable fonts. Preloaded so the swap happens before
          first paint rather than shifting text afterwards. --}}
    <link rel="preload" href="{{site.base}}/assets/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="{{site.base}}/assets/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin>

    {{!-- The whole stylesheet is inlined: it is small enough that a separate
          request would cost more than it saves, and this leaves the page with
          zero render-blocking round trips. --}}
    <style>{{{inlineCss}}}</style>

    <link rel="icon" type="image/png" sizes="96x96" href="{{site.base}}/assets/images/favicon-96x96.png">
    <link rel="apple-touch-icon" href="{{site.base}}/assets/images/spike-badge-180.png">
    <link rel="manifest" href="{{site.base}}/site.webmanifest">

    <meta property="og:site_name" content="Spike">
    <meta property="og:type" content="{{#if isTerm}}article{{else}}website{{/if}}">
    <meta property="og:title" content="{{pageTitle}}">
    <meta property="og:description" content="{{metaDescription}}">
    <meta property="og:url" content="{{pageUrl}}">
    <meta property="og:image" content="{{ogImage}}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="{{#if isTerm}}{{term}} — a term from the Spike incident response glossary{{else}}The Spike incident response glossary{{/if}}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:site" content="@spikedhq">
    <meta name="twitter:title" content="{{pageTitle}}">
    <meta name="twitter:description" content="{{metaDescription}}">
    <meta name="twitter:image" content="{{ogImage}}">

    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "Organization",
                "@id": "https://spike.sh/#organization",
                "name": "Spike.sh",
                "url": "https://spike.sh",
                "logo": "https://spike.sh/spike-badge-150.png",
                "description": "Spike.sh is an incident response platform that helps engineering and ops teams stay ahead of incidents with real-time alerts, automated response playbooks, and status pages.",
                "sameAs": [
                    {{{json site.social.linkedin}}},
                    {{{json site.social.reddit}}},
                    {{{json site.social.youtube}}},
                    {{{json site.social.x}}}
                ]
            },
            {
                "@type": "DefinedTermSet",
                "@id": {{{json (concat site.url "/#glossary")}}},
                "name": "Spike Incident Response Glossary",
                "description": {{{json site.description}}},
                "url": {{{json (concat site.url "/")}}},
                "inLanguage": "en",
                "publisher": { "@id": "https://spike.sh/#organization" }
            },
            {{#if isTerm}}
            {
                "@type": "DefinedTerm",
                "@id": {{{json pageUrl}}},
                "name": {{{json term}}},
                "description": {{{json excerpt}}},
                "url": {{{json pageUrl}}},
                "inDefinedTermSet": { "@id": {{{json (concat site.url "/#glossary")}}} }
            },
            {{else}}
            {
                "@type": "WebSite",
                "@id": {{{json (concat site.url "/#website")}}},
                "url": {{{json (concat site.url "/")}}},
                "name": "Spike Incident Response Glossary",
                "publisher": { "@id": "https://spike.sh/#organization" },
                "potentialAction": {
                    "@type": "SearchAction",
                    "target": {
                        "@type": "EntryPoint",
                        "urlTemplate": {{{json (concat site.url "/?q={search_term_string}")}}}
                    },
                    "query-input": "required name=search_term_string"
                }
            },
            {
                "@type": "FAQPage",
                "@id": {{{json (concat site.url "/#faq")}}},
                "mainEntity": [
                    {
                        "@type": "Question",
                        "name": "What is the Incident Response Glossary?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "It's a curated collection of 500+ terms to help teams understand key concepts in incident management, monitoring, on-call response, and DevOps."
                        }
                    },
                    {
                        "@type": "Question",
                        "name": "How can I use this glossary?",
                        "acceptedAnswer": {
                            "@type": "Answer",
                            "text": "You can browse terms alphabetically, use the search, or explore related terms to learn incident response more effectively."
                        }
                    }
                ]
            },
            {{/if}}
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Spike", "item": "https://spike.sh" },
                    { "@type": "ListItem", "position": 2, "name": "Glossary", "item": {{{json (concat site.url "/")}}} }{{#if isTerm}},
                    { "@type": "ListItem", "position": 3, "name": {{{json term}}}, "item": {{{json pageUrl}}} }{{/if}}
                ]
            }
        ]
    }
    </script>
</head>

<body>
    <a class="skip-link" href="#main">Skip to content</a>

    {{> site-header}}

    <main id="main">
        {{{content}}}
    </main>

    {{> site-footer}}

    <script src="{{site.base}}/assets/js/glossary.js" defer></script>
</body>

</html>
